#include <stdio.h>

int main() {
    // 1. Declaración (como en tu imagen)
    int numeros[5];

    // 2. Asignación manual de valores
    numeros[0] = 10;
    numeros[1] = 20;
    numeros[2] = 30;
    numeros[3] = 40;
    numeros[4] = 50;

    // 3. Acceder y mostrar un valor específico
    printf("El tercer elemento (indice 2) es: %d\n", numeros[2]);

    // 4. Mostrar todos usando un ciclo (forma eficiente)
    printf("Todos los elementos del arreglo:\n");
    for (int i = 0; i < 5; i++) {
        printf("numeros[%d] = %d\n", i, numeros[i]);
    }

    return 0;
}
