int diagonal(int m[3][3]){
int i,suma=0;

 for(int i=0; i<3;i++){
    suma=suma+m[i][i];
 }
 return suma;
}




int main()
{
    int matriz[3][3];
    capturar(matriz);
    mostrar(matriz);
    int resultado=diagonal(matriz);
    printf("%d",resultado);




