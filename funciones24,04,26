#include <stdio.h>
#include <stdlib.h>


void capturar( int m[3][3]){
    int i,j;
 for(int i=0;i<3;i++){
    for(int j=0;j<3;j++){
        scanf("%d", &m[i][j]);
    }
 }
}

void mostrar(int m[3][3]){
    int i,j;
 for(int i=0;i<3;i++){
    for(int j=0;j<3;j++){
        scanf("%d", &m[i][j]);
    }
 }
}
