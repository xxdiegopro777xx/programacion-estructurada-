#include <stdio.h>
#include <string.h>

int main()
{
    // Arreglo de 3 jugadores predefinidos
    char jugadores[3][20];
    strcpy(jugadores[0], "Ana");
    strcpy(jugadores[1], "Luis");
    strcpy(jugadores[2], "Carlos");

    // Arreglo para capturar 5 jugadores
    char jugador[5][20];
    int longitud;

    for(int i = 0; i < 5; i++)
    {
        printf("Anota el jugador %d: \n", i + 1);
        fgets(jugador[i], sizeof(jugador[i]), stdin);

        longitud = strlen(jugador[i]);
        printf("La longitud de %s es %d\n", jugador[i], longitud);
    }

    return 0;
}
