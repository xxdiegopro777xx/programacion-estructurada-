#include <stdio.h>
#include <string.h>

#define FILAS 5
#define COLS  5

/* ── Prototipos ──────────────────────────────────────────── */
void inicializarTablero(char tablero[FILAS][COLS]);
void colocarBarcos(char tablero[FILAS][COLS]);
void mostrarTablero(char tablero[FILAS][COLS]);
int  registrarImpacto(char tablero[FILAS][COLS], int f, int c);
void registrarAgua(char tablero[FILAS][COLS], int f, int c);
void guardarEnArchivo(char tablero[FILAS][COLS], const char *nombre);

/* ── main ────────────────────────────────────────────────── */
int main(void)
{
    char tablero[FILAS][COLS];


    char jugador[20];
    printf("Nombre: ");
    fgets(jugador, sizeof(jugador), stdin);
    jugador[strcspn(jugador, "\n")] = '\0';

    char barcos[3][15] = {"Fragata", "Destructor", "Submarino"};
    int  barcosEncontrados = 0;

    inicializarTablero(tablero);
    colocarBarcos(tablero);

    printf("\n--- Tablero inicial ---\n");
    mostrarTablero(tablero);


    for (int turno = 0; turno < 5; turno++) {
        int fila, columna;

        printf("\nTurno %d de %s\n", turno + 1, jugador);
        printf("Fila    (1-5): ");
        scanf("%d", &fila);
        printf("Columna (1-5): ");
        scanf("%d", &columna);

        int f = fila    - 1;
        int c = columna - 1;


        if (f < 0 || f >= FILAS || c < 0 || c >= COLS) {
            printf("Coordenadas fuera de rango. Turno perdido.\n");
            continue;
        }


        if (tablero[f][c] == 'X' || tablero[f][c] == 'O') {
            printf("Ya disparaste aquí. Turno perdido.\n");
            continue;
        }


        if (registrarImpacto(tablero, f, c)) {
            printf("%s impactó un %s!\n", jugador, barcos[barcosEncontrados]);
            barcosEncontrados++;
        } else {
            registrarAgua(tablero, f, c);
            printf("Agua...\n");
        }

        mostrarTablero(tablero);
    }


    guardarEnArchivo(tablero, "tablero.txt");
    printf("\nTablero guardado en tablero.txt\n");

    if (barcosEncontrados == 3)
        printf("\n%s ganó la partida!\n", jugador);
    else
        printf("\n%s no logró hundir todos los barcos. Barcos hundidos: %d/3\n",
               jugador, barcosEncontrados);

    return 0;
}

/* ── Funciones ───────────────────────────────────────────── */

void inicializarTablero(char tablero[FILAS][COLS])
{
    for (int i = 0; i < FILAS; i++)
        for (int j = 0; j < COLS; j++)
            tablero[i][j] = '~';
}


void colocarBarcos(char tablero[FILAS][COLS])
{
    tablero[0][1] = 'B';
    tablero[2][3] = 'B';
    tablero[4][4] = 'B';
}


void mostrarTablero(char tablero[FILAS][COLS])
{
    printf("    ");
    for (int j = 0; j < COLS; j++)
        printf("%d ", j + 1);
    printf("\n");

    for (int i = 0; i < FILAS; i++) {
        printf("%d   ", i + 1);
        for (int j = 0; j < COLS; j++) {
            char celda = tablero[i][j];
            /* Los barcos no disparados se ocultan */
            if (celda == 'B') celda = '~';
            printf("%c ", celda);
        }
        printf("\n");
    }
}


int registrarImpacto(char tablero[FILAS][COLS], int f, int c)
{
    if (tablero[f][c] == 'B') {
        tablero[f][c] = 'X';
        return 1;
    }
    return 0;
}


void registrarAgua(char tablero[FILAS][COLS], int f, int c)
{
    tablero[f][c] = 'O';
}


void guardarEnArchivo(char tablero[FILAS][COLS], const char *nombre)
{
    FILE *archivo = fopen(nombre, "w");
    if (archivo == NULL) {
        printf("Error al abrir el archivo.\n");
        return;
    }

    fprintf(archivo, "    ");
    for (int j = 0; j < COLS; j++)
        fprintf(archivo, "%d ", j + 1);
    fprintf(archivo, "\n");

    for (int i = 0; i < FILAS; i++) {
        fprintf(archivo, "%d   ", i + 1);
        for (int j = 0; j < COLS; j++) {
            char celda = tablero[i][j];
            if (celda == 'B') celda = '~';
            fprintf(archivo, "%c ", celda);
        }
        fprintf(archivo, "\n");
    }

    fprintf(archivo, "\nLeyenda: ~ agua  X impacto  O fallo\n");
    fclose(archivo);
}
